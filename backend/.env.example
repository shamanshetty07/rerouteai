# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secret used to sign session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET="change-me"
# Public URL of this server, used to build OAuth callback URLs.
BASE_URL="http://localhost:8000"

# OAuth apps. Callback URLs: $BASE_URL/auth/github/callback and $BASE_URL/auth/google/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
