# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secret used to sign session cookies and OAuth state (e.g. `openssl rand -hex 32`). Required.
# In production the server refuses to start unless it is at least 32 characters and not a placeholder.
SESSION_SECRET=""
# Public URL of this server, used to build OAuth callback URLs. In production it must be https://.
BASE_URL="http://localhost:8000"

# OAuth apps (see README "OAuth setup"). Register exactly these callback URLs with each provider:
#   $BASE_URL/auth/github/callback    $BASE_URL/auth/google/callback
# A provider whose id or secret is empty answers 503 "not configured" instead of redirecting.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# RailRadar API key for train data.
RAILRADAR_API_KEY=""

# Local development only: lets you sign in without OAuth at /auth/dev/login (see README).
# Anything other than the exact value "true" leaves it off. The server refuses to start
# with this enabled when NODE_ENV=production.
# DEV_LOGIN="true"

# Number of reverse proxies in front of this server (e.g. 1), or a subnet/keyword such as "loopback".
# Leave unset when clients connect directly. Never "true": that would trust any X-Forwarded-For
# header and let clients dodge the rate limits. Behind a proxy, set it, or every client shares one IP.
# TRUST_PROXY=1
