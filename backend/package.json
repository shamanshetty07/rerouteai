{
  "name": "backend",
  "module": "src/server/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build:web": "bun build src/web/search.ts --outdir public/assets --target browser --minify",
    "predev": "bun run build:web",
    "dev": "bun --hot src/server/index.ts",
    "prestart": "bun run build:web",
    "start": "bun src/server/index.ts",
    "test": "bun test",
    "db:migrate": "bun scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "contract:emit": "prisma contract emit",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.13",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "prisma": "8.0.0-rc.19"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.3",
    "@prisma/cli-engine": "0.6.2",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
